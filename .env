# ============================================================
# Vault — environment variables
# Copy this file to .env and fill in the required values.
# ============================================================

# ── Required ─────────────────────────────────────────────────

# Secret used to sign session cookies.
# Generate a strong random value, e.g.:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# ── Database ─────────────────────────────────────────────────

# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=vaultpass

# If you supply your own external PostgreSQL instance, override
# the full connection string here (and remove the db service
# from docker-compose.yml):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Storage ──────────────────────────────────────────────────

# Host path where uploaded files are stored.
# On Unraid, point this at a User Share:
UPLOAD_DIR=/mnt/user/appdata/vault/uploads

# ── Network ──────────────────────────────────────────────────

# Host port the Vault web UI is exposed on.
HOST_PORT=3000
