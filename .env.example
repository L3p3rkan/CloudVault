# ============================================================
# Vault — environment variables
#
# Copy this file to .env and fill in the values before running
# docker compose up -d
# ============================================================

# Recommended: set to a long random string so sessions survive container
# restarts.  Generate one with:  openssl rand -hex 32
# If left empty, a random secret is generated each startup (sessions reset
# on every restart, but the app still works).
SESSION_SECRET=

# Password for the internal PostgreSQL container.
# Change this before exposing the DB port to your network.
POSTGRES_PASSWORD=vaultpass

# Host port the Vault web UI is available on (default: 3000).
# HOST_PORT=3000

# Host port for direct PostgreSQL access (optional — remove from
# docker-compose.yml if you don't need external DB access).
# DB_HOST_PORT=5432

# Where uploaded files are stored inside the container.
# Map this to a persistent path on the host, e.g.:
#   /mnt/user/appdata/vault/uploads  (Unraid)
#   ./data/uploads                   (local dev)
# UPLOAD_DIR=/data/uploads

# Set to "true" only when behind a TLS reverse proxy (HTTPS).
# Leave unset for plain-HTTP LAN / Unraid access.
# COOKIE_SECURE=true
